		          <article class="news-card">
              <a href="https://www.dcm.co.uk/news/box-office-other-mommy-makes-millions">
          <img
            class="news-card__image"
            src="https://www.dcm.co.uk/uploads/images/_newsCard/other-mommy-trailer.jpg"
            alt=""
            width="1653"
            height="1000"
            loading="lazy"
          >
        </a>
